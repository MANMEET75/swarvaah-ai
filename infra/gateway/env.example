# Copy to the repository root as .env.gateway; never commit the filled file.
GATEWAY_DOMAIN=voice.example.com
SWARVAAH_DB_PASSWORD=replace-with-url-safe-random-password
SWARVAAH_MODE=pilot
CALL_MODE=exotel
LIVE_DIAL_ENABLED=true
CONVERSATION_MODE=sarvam
SARVAM_CHAT_MODEL=sarvam-105b-conversations
MAX_GLOBAL_CONCURRENT=1
MAX_DIALS_PER_MINUTE=1
TWILIO_FALLBACK_ENABLED=false
ADMIN_API_KEY=replace-with-random-secret
PUBLIC_BASE_URL=https://voice.example.com
EXOTEL_STREAM_URL=wss://voice.example.com/ws/exotel
# Singapore Exotel pilot account; use api.in.exotel.com for an India account.
EXOTEL_API_BASE_URL=https://api.exotel.com
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_CALLBACK_SECRET=replace-with-random-secret
SARVAM_API_KEY=
